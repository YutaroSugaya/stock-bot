# stock-bot 環境変数テンプレ(値は入れない・これはコミット対象)
#
#   cp .env.example .env    # .env は gitignore + pre-commit 拒否(scripts/pre-commit.sh)
#   vim .env                # <> の箇所に実値を貼る。パスは自分の環境に合わせる
#   source .env             # 各行が export 付きなのでこれだけで効く
#
# ⚠️ .env / secrets/*.pem は絶対にコミットしない。第二パスワードは特に。
#
# 下の例のパスは「repo を $HOME/src/stock-bot に置いた」前提。置き場所に合わせて書き換える。

# ────────────────────────────────────────────────────────────
# 立花 e支店 公開鍵認証(v4r9 / v4r10 共通)
#   認証ID・秘密鍵は立花の標準 Web 画面で取得する。デモと本番は別セット。
# ────────────────────────────────────────────────────────────
# demo | production。production でも参照系しか使わない経路
# (live-probe / fetch-daily / paper_live_feed)は実弾を飛ばさない。
# 実弾が飛ぶのは mode: live_config + LIVE_CONFIRMED=1 のときだけ。
export STOCKBOT_TACHIBANA_ENV=demo               # 本番口座に繋ぐときだけ production にする
export STOCKBOT_TACHIBANA_AUTH_ID=            # ← 認証ID(sAuthId)を貼る
export STOCKBOT_TACHIBANA_PRIVATE_KEY_FILE=$HOME/src/stock-bot/secrets/e_api_private_key.pem
export STOCKBOT_TACHIBANA_SECOND_PASSWORD=    # ← 第二パスワードを貼る(発注/取消で必須。参照系のみの起動でも構築チェックが要求する)

# 共通の config パス(paper / demo / live 共通)
export STOCKBOT_HARD_LIMITS=$HOME/src/stock-bot/configs/hard_limits.yaml
export STOCKBOT_DAILY_CANDLES_DIR=$HOME/src/stock-bot/backend/data

# TOPIX ベンチマーク(bench_topix.csv)を make fetch-daily で一緒に更新する場合の
# 立花銘柄コード。指数コードを probe(GetKlines 1回)で裏取りしてから設定する。
# 未設定なら bench は触らない(fail-close)。水準の違う系列(ETF 等)は strict merge が拒否する。
# export STOCKBOT_BENCH_SYMBOL=

# 永続化(Postgres)。未設定だと in-memory = 再起動で LLM 判断履歴・paper 建玉が消える。
#   docker compose up -d db
#   STOCKBOT_HUMAN_APPROVED_DB_WRITE=1 make migrate-up
# DB 名は docker-compose.yml の POSTGRES_DB と揃える(既定 stockbot)。
# research と live の台帳は別 DB に分ける(下の STOCKBOT_LIVE_DATABASE_URL)。
export STOCKBOT_DATABASE_URL="postgres://stockbot:stockbot@localhost:5434/stockbot?sslmode=disable"

# 分足レコーダー(実フィードの分足を CSV に貯める。read-only)
export STOCKBOT_RECORD_CANDLES_DIR=$HOME/src/stock-bot/backend/data

# 制御 API とダッシュボード。既定は loopback(127.0.0.1:8090)。
# 0.0.0.0 など loopback 以外に bind するなら STOCKBOT_API_TOKEN を必ず設定する
# (無いと変更系は全部 403。参照系は token が無いと誰でも読める)。
# export STOCKBOT_HTTP_ADDR=127.0.0.1:8090
# export STOCKBOT_API_TOKEN=            # X-Api-Token ヘッダ / Authorization: Bearer で照合

# 引け後の日次総評 段 2(claude CLI + WebSearch・課金)。既定 off。使うなら on。
# export STOCKBOT_DAILY_REVIEW_STAGE2=on
# claude CLI の場所(stockbot-routine.sh の gonogo / cli-update が使う。既定 ~/.local/bin/claude)
# export STOCKBOT_CLAUDE_CLI=$HOME/.local/bin/claude

# ────────────────────────────────────────────────────────────
# live トラック(mode: live_config)— 守り 4 点(受理 / 常駐 / 発動方向 / bot 停止下の約定)の
# 実機裏取りが終わるまでコメントアウトのまま。OCO_VERIFIED を立てるのは実証後・人間判断のみ。
# 認証セットは上と同じ(本番)。live は Postgres 必須(in-memory は起動拒否)。
# live の DSN と emergency flag は research と**異なる**ことを起動時に fail-close で検証する。
# ────────────────────────────────────────────────────────────
# export STOCKBOT_TACHIBANA_OCO_VERIFIED=1     # 実証後のみ(文字列 "1" 完全一致)
# export STOCKBOT_LIVE_CONFIRMED=1             # live_config の人間ゲート
# export STOCKBOT_LIVE_BOT_CONFIG=$HOME/src/stock-bot/configs/bot_config.live.yaml
# export STOCKBOT_LIVE_STRATEGY_CONFIG=$HOME/src/stock-bot/configs/strategy_config.live.yaml
# export STOCKBOT_LIVE_DATABASE_URL="postgres://stockbot:stockbot@localhost:5434/stockbot_live?sslmode=disable"
# export STOCKBOT_LIVE_EMERGENCY_FLAG=$HOME/.stockbot/live_emergency_stop.flag
